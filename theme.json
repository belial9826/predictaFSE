{
    "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
    "version": 2,
    "title": "Predicta FSE Design Tokens",
    "settings": {
        "appearanceTools": true,
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true,
            "radiusSizes": [
                {
                    "name": "Pequeño (rounded)",
                    "slug": "small",
                    "size": "4px"
                },
                {
                    "name": "Medio (rounded-xl)",
                    "slug": "medium",
                    "size": "12px"
                },
                {
                    "name": "Grande (rounded-2xl)",
                    "slug": "large",
                    "size": "16px"
                },
                {
                    "name": "Contenedor (rounded-3xl)",
                    "slug": "full",
                    "size": "24px"
                }
            ]
        },
        "color": {
            "custom": true,
            "customGradient": true,
            "customDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "gradients": [
                {
                    "name": "Degradado Hero (Oscuro)",
                    "slug": "dark-hero",
                    "gradient": "linear-gradient(180deg, #171717 0%, #0c0c0c 100%)"
                },
                {
                    "name": "Degradado IA (Tecnológico)",
                    "slug": "tech-gradient",
                    "gradient": "linear-gradient(135deg, #10b981 0%, #3b82f6 100%)"
                },
                {
                    "name": "Vidrio / Glassmorphism",
                    "slug": "glass-gradient",
                    "gradient": "linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%)"
                },
                {
                    "name": "Degradado Pitch / Campo",
                    "slug": "pitch-gradient",
                    "gradient": "linear-gradient(to bottom right, #6cabdd 0%, #1c2c5b 100%)"
                }
            ],
            "palette": [
                {
                    "name": "Fondo General (Negro Profundo)",
                    "slug": "base",
                    "color": "#050505"
                },
                {
                    "name": "Fondo Silo/CPT (Negro)",
                    "slug": "deep-black",
                    "color": "#0a0a0a"
                },
                {
                    "name": "Tarjeta Oscura (Gris Oscuro)",
                    "slug": "dark-card",
                    "color": "#0e0e0e"
                },
                {
                    "name": "Borde Oscuro",
                    "slug": "border-dark",
                    "color": "#171717"
                },
                {
                    "name": "Borde Medio",
                    "slug": "border-gray",
                    "color": "#262626"
                },
                {
                    "name": "Texto Principal (Gris Claro)",
                    "slug": "contrast",
                    "color": "#e5e5e5"
                },
                {
                    "name": "Blanco Puro",
                    "slug": "white",
                    "color": "#ffffff"
                },
                {
                    "name": "Verde IA (Tecnológico)",
                    "slug": "primary",
                    "color": "#10b981"
                },
                {
                    "name": "Azul Eléctrico (Métricas)",
                    "slug": "secondary",
                    "color": "#3b82f6"
                },
                {
                    "name": "Celeste (Equipo/Acento)",
                    "slug": "accent",
                    "color": "#6cabdd"
                },
                {
                    "name": "Oro / Destacados (Ámbar)",
                    "slug": "gold",
                    "color": "#fbbf24"
                },
                {
                    "name": "Fondo Artículo (Claro)",
                    "slug": "light-bg",
                    "color": "#FAFaf9"
                },
                {
                    "name": "Texto Artículo (Claro)",
                    "slug": "light-text",
                    "color": "#1c1917"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
                    "name": "Plus Jakarta Sans (Sans)",
                    "slug": "sans",
                    "fontFace": [
                        {
                            "fontFamily": "Plus Jakarta Sans",
                            "fontWeight": "300 800",
                            "fontStyle": "normal",
                            "fontStretch": "normal",
                            "src": [
                                "https://fonts.gstatic.com/s/plusjakartasans/v8/L0x5DF4xlVhp-I7AJm6SZsgF13H6FSqY.woff2"
                            ]
                        }
                    ]
                },
                {
                    "fontFamily": "'JetBrains Mono', monospace",
                    "name": "JetBrains Mono (Mono)",
                    "slug": "mono",
                    "fontFace": [
                        {
                            "fontFamily": "JetBrains Mono",
                            "fontWeight": "300 700",
                            "fontStyle": "normal",
                            "src": [
                                "https://fonts.gstatic.com/s/jetbrainsmono/v18/tuf7I-c6J12qpHw562tK5Lx4c22n.woff2"
                            ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Muy Pequeña (text-xs)",
                    "size": "0.75rem",
                    "slug": "x-small"
                },
                {
                    "name": "Pequeña (text-sm)",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "name": "Normal (text-base)",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "name": "Mediana (text-lg)",
                    "size": "1.125rem",
                    "slug": "normal"
                },
                {
                    "name": "Grande (text-xl)",
                    "size": "1.25rem",
                    "slug": "large"
                },
                {
                    "name": "Muy Grande (text-2xl)",
                    "size": "1.5rem",
                    "slug": "x-large"
                },
                {
                    "name": "Gigante (text-3xl)",
                    "size": "1.875rem",
                    "slug": "xx-large"
                },
                {
                    "name": "Cabecera Hero (text-4xl)",
                    "size": "2.25rem",
                    "slug": "xxx-large"
                }
            ],
            "lineHeight": true
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--accent)"
                },
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--primary)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--white)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--mono)",
                    "fontWeight": "600",
                    "textTransform": "uppercase",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "letterSpacing": "0.05em"
                },
                "border": {
                    "radius": "var(--wp--preset--border--radius--medium)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem",
                        "right": "1.5rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--secondary)",
                        "text": "var(--wp--preset--color--white)"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xxx-large)",
                    "fontWeight": "800",
                    "lineHeight": "1.1",
                    "letterSpacing": "-0.025em"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "700",
                    "lineHeight": "1.2",
                    "letterSpacing": "-0.025em"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "700",
                    "lineHeight": "1.3"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "700",
                    "lineHeight": "1.4"
                }
            }
        },
        "blocks": {
            "core/post-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontWeight": "800",
                    "letterSpacing": "-0.03em"
                }
            },
            "core/post-excerpt": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--normal)"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontWeight": "500"
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Cabecera"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Pie de página"
        }
    ],
    "customTemplates": [
        {
            "name": "page-contacto",
            "title": "Contacto",
            "postTypes": ["page"]
        },
        {
            "name": "page-faq",
            "title": "FAQ",
            "postTypes": ["page"]
        },
        {
            "name": "page-pronosticos",
            "title": "Pronósticos de fútbol",
            "postTypes": ["page"]
        }
    ]
}
